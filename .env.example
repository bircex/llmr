# Required. Seals every stored credential. Make one with:
#   docker run --rm ghcr.io/bircex/llmr keygen
# Keep a copy somewhere safe: without it, stored credentials cannot be read.
LLMR_MASTER_KEY=

# Optional. Tokens callers must present as `Authorization: Bearer <token>`, comma separated.
# Unset, nothing is checked, and the port must only be reachable by the panel.
LLMR_TOKEN=

# RUST_LOG=info
# LLMR_LOG_FORMAT=json
